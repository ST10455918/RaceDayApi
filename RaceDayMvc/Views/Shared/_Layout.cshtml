<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RaceDay - @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            :root{--orange:#FF6B00;--navy:#0A1931}
            .navbar{background:var(--navy)!important}
            .btn-orange{background:var(--orange);color:#fff;font-weight:bold}
            body{background:#f5f7fb}
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🏁 RaceDay</a>
            <div class="navbar-nav ms-auto">
                @{
                    var role = Context.Session.GetString("Role");
                    if (role == "Organiser")
                    {
                        <a class="nav-link" href="/Organiser/Dashboard">Dashboard</a><a class="nav-link" href="/Account/Logout">Logout</a>
                    }
                    else if (role == "Participant")
                    {

                        <a class="nav-link" href="/Participant/Index">Events</a><a class="nav-link" href="/Participant/MyResults">My Results</a><a class="nav-link" href="/Participant/Profile">Profile</a><a class="nav-link" href="/Account/Logout">Logout</a>
                    }
                    else
                    {

                        <a class="nav-link" href="/Account/Login">Login</a><a class="nav-link" href="/Account/Register">Register</a>
                    }

                }
            </div>
        </div>
    </nav>
    <div class="container mt-4">@RenderBody()</div>
    @RenderSection("Scripts", false)
</body></html>