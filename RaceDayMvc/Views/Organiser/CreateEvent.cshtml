@{
    ViewData["Title"] = "Create Event";
}
<div class="card shadow-sm p-4 mx-auto" style="max-width:700px;">
    <h3 class="fw-bold" style="color:#0A1931;">Create New Event</h3>
    <p class="text-muted">This uploads banner to Azure Blob Storage (Requirement 5)</p>

    <form id="eventForm">
        <input name="Name" class="form-control mb-3" placeholder="Event Name: Cape Town Marathon" required />
        <textarea name="Description" class="form-control mb-3" placeholder="Description: Annual city marathon..."></textarea>
        <input name="Date" type="date" class="form-control mb-3" required />
        <input name="VenueId" type="number" class="form-control mb-3" placeholder="Venue ID (1)" value="1" required />

        <label class="fw-bold mt-2">Event Banner Image (Azure Blob)</label>
        <input type="file" id="bannerFile" class="form-control mb-3" accept="image/*" />
        <img id="preview" style="max-width:100%; display:none; border-radius:12px; border:2px solid #FF6B00;" class="mb-3" />

        <button type="submit" class="btn btn-orange w-100 py-2">Create Event</button>
    </form>

    <div id="status" class="mt-3"></div>
</div>

<script>
    document.getElementById('eventForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        document.getElementById('status').innerHTML = '<div class="alert alert-info">Creating event...</div>';

        const apiBase = 'https://localhost:7164'; // CHANGE PORT IF NEEDED

        const formData = {
            Name: e.target.Name.value,
            Description: e.target.Description.value,
            Date: e.target.Date.value,
            VenueId: parseInt(e.target.VenueId.value),
            OrganiserId: 1
        };

        try {
            const res = await fetch(apiBase + '/api/events', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            });

            if (!res.ok) throw new Error('Failed to create');
            const ev = await res.json();

            const fileInput = document.getElementById('bannerFile');
            if (fileInput.files.length > 0) {
                document.getElementById('status').innerHTML = '<div class="alert alert-warning">Uploading banner to Azure Blob...</div>';
                const fd = new FormData();
                fd.append('file', fileInput.files[0]);
                const uploadRes = await fetch(${ apiBase } / api / events / ${ ev.id } / upload - banner, { method: 'POST', body: fd });
                const result = await uploadRes.json();
                document.getElementById('status').innerHTML = <div class="alert alert-success" >✅ Event created with banner! URL: ${ result.imageUrl } <br><img src="${result.imageUrl}" width = "200" style = "border-radius:8px" class="mt-2" > </div>;
                setTimeout(() => { window.location = '/Organiser/Dashboard'; }, 2000);
            } else {
                document.getElementById('status').innerHTML = '<div class="alert alert-success">Event created!</div>';
                setTimeout(() => { window.location = '/Organiser/Dashboard'; }, 1000);
            }
        } catch (err) {
            document.getElementById('status').innerHTML = <div class="alert alert-danger" > Error: ${ err.message } -Is API running ? </div>;
        }
    });

    // Preview image before upload
    document.getElementById('bannerFile').addEventListener('change', e => {
        if (e.target.files[0]) {
            const url = URL.createObjectURL(e.target.files[0]);
            document.getElementById('preview').src = url;
            document.getElementById('preview').style.display = 'block';
        }
    });
</script>