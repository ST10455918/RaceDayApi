@{
    ViewData["Title"] = "Profile";
}
<div class="card shadow-sm p-4 mx-auto" style="max-width:600px;">
    <h3 class="fw-bold">My Profile</h3>
    <p><b>Email:</b> @Context.Session.GetString("Email")</p>
    <p><b>Role:</b> <span class="badge bg-primary">@Context.Session.GetString("Role")</span></p>
    <p><b>User ID:</b> @Context.Session.GetInt32("UserId")</p>

    <hr>
    <h5>Profile Picture (Azure Blob Storage)</h5>
    <p class="text-muted">Requirement 5: Images stored in Azure Blob</p>
    <input type="file" id="profileFile" class="form-control mb-3" accept="image/*" />
    <img id="profilePreview" style="max-width:150px; border-radius:50%; display:none; border:3px solid #FF6B00;" class="mb-3" />
    <button onclick="uploadProfile()" class="btn btn-orange w-100">Upload Picture to Azure</button>
    <div id="result" class="mt-3"></div>
</div>

<script>
    async function uploadProfile() {
        const userId = @Context.Session.GetInt32("UserId");
        const apiBase = 'https://localhost:7164';
        const file = document.getElementById('profileFile').files[0];
        if (!file) { alert('Select file first'); return; }
        const fd = new FormData(); fd.append('file', file);
        document.getElementById('result').innerHTML = '<div class="alert alert-info">Uploading to Blob...</div>';
        const res = await fetch(${ apiBase } / api / auth / ${ userId } / upload - profile, { method: 'POST', body: fd });
        const d = await res.json();
        document.getElementById('result').innerHTML = <div class="alert alert-success" >✅ Uploaded to Blob! < br > URL: ${ d.imageUrl } <br><img src="${d.imageUrl}" width = "150" style = "border-radius:12px" class="mt-2" > </div>;
    }
    document.getElementById('profileFile').addEventListener('change', e => {
        const url = URL.createObjectURL(e.target.files[0]); document.getElementById('profilePreview').src = url; document.getElementById('profilePreview').style.display = 'block';
    });
</script>